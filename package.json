{
  "name": "looba-mcp",
  "version": "1.4.1",
  "private": false,
  "type": "module",
  "description": "MCP server for browsing Looba UI snippets — search posts, read code, and discover authors.",
  "main": "index.js",
  "bin": {
    "looba-mcp": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test tests/*.test.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.3.6"
  },
  "keywords": [
    "mcp",
    "looba",
    "ui",
    "snippets",
    "css",
    "html",
    "design"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/looba-snippet/looba-mcp.git"
  },
  "devDependencies": {
    "agents": "^0.21.0",
    "wrangler": "^4.123.0"
  }
}
